# ==============================================================================
# TataDana — Environment Variables Template for Vercel & Production Deployment
# ==============================================================================

# Application & Timezone
APP_ENV=production
TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_APP_URL=https://your-tatadana-app.vercel.app

# Supabase (Wajib diisi sesuai project Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...anon_public_key
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...service_role_secret_key
SUPABASE_STORAGE_BUCKET=tatadana-reports

# Admin WhatsApp & Pro Price Settings
NEXT_PUBLIC_ADMIN_WA_NUMBER=6289655786828
NEXT_PUBLIC_PRO_PRICE=Rp29.000 / bulan

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
WEBHOOK_BASE_URL=https://your-tatadana-app.vercel.app

# Multi-AI Providers (Orchestration Gemini / OpenAI / DeepSeek)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
