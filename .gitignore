# ============================================================
# TataDana - .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (JANGAN PERNAH commit!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
.next/
out/
dist/
build/

# Testing
coverage/
.nyc_output

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath

# Vercel
.vercel

# Supabase local dev
supabase/.temp/
supabase/functions/.cache/

# Temporary files
*.tmp
*.temp
/tmp/

# Log files
logs/
*.log

# Optional: yarn lock file (pilih salah satu: npm atau yarn)
# yarn.lock

# Coverage reports
/coverage

# Sentry
.sentryclirc

# Python cache & local db store
__pycache__/
*.pyc
*.pyo
*.pyd
tatadana_store.json
app/static/exports/*
!app/static/exports/.gitkeep
